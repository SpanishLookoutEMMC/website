{
  "id": "sl-emmc",
  "viewports": [
    { "label": "desktop", "width": 1280, "height": 900 },
    { "label": "mobile",  "width": 390,  "height": 844 }
  ],
  "scenarios": [
    { "label": "Home",              "url": "http://localhost:3000/index.html",      "delay": 300 },
    { "label": "Church",            "url": "http://localhost:3000/church.html",     "delay": 300 },
    { "label": "Team",              "url": "http://localhost:3000/team.html",       "delay": 300 },
    { "label": "Sermons",           "url": "http://localhost:3000/sermons.html",    "delay": 300, "hideSelectors": ["iframe"] },
    { "label": "Mission",           "url": "http://localhost:3000/faith.html",      "delay": 300 },
    { "label": "Confession",        "url": "http://localhost:3000/confession.html", "delay": 300 },
    { "label": "Membership",        "url": "http://localhost:3000/membership.html", "delay": 300 },
    { "label": "Contact",           "url": "http://localhost:3000/contact.html",    "delay": 300 }
  ],
  "paths": {
    "bitmaps_reference": "backstop_data/bitmaps_reference",
    "bitmaps_test":      "backstop_data/bitmaps_test",
    "html_report":       "backstop_data/html_report",
    "engine_scripts":    "backstop_data/engine_scripts"
  },
  "report": ["browser"],
  "engine": "puppeteer",
  "engineOptions": {
    "args": ["--no-sandbox"]
  },
  "asyncCaptureLimit": 3,
  "asyncCompareLimit": 50,
  "misMatchThreshold": 0.1,
  "requireSameDimensions": true
}
